# Scout Festival backend environment variables
# Default SQLite local database URL
DATABASE_URL="file:./dev.db"

# Optional Supabase PostgreSQL database URL:
# DATABASE_URL="postgresql://postgres.fkolbvgigrlyssiinmza:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.fkolbvgigrlyssiinmza:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
# Production seed is disabled unless explicitly set to exactly: I_UNDERSTAND_THIS_MODIFIES_DATA
ALLOW_PRODUCTION_SEED=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# One-time production admin creation/reset; remove or set false immediately after deployment.
BOOTSTRAP_ADMIN=false
INITIAL_JUDGE_USERNAME=
INITIAL_JUDGE_PASSWORD=
INITIAL_TEAM_USERNAME=
INITIAL_TEAM_PASSWORD=
INITIAL_TEAM_LABEL=
# SQLite path used by operational checks/backup scripts. Set an absolute production path.
SQLITE_DATABASE_PATH=./prisma/dev.db
# Persistent, access-restricted backup directory; do not place backups in public/uploads.
SQLITE_BACKUP_DIR=../scout-backups
FRONTEND_URL=https://your-huggingface-space.hf.space
# Comma-separated production allowlist; localhost is allowed automatically outside production.
CORS_ORIGINS=https://your-huggingface-space.hf.space
# Production must be a unique random value, at least 32 characters.
NODE_ENV=production
# Keep decoded uploads below the 12 MiB JSON-body ceiling (Base64 adds about 33%).
MAX_UPLOAD_BYTES=8388608
JSON_BODY_LIMIT_BYTES=12582912
URLENCODED_BODY_LIMIT_BYTES=12582912
SOCKET_MAX_BUFFER_BYTES=12582912
SOCKET_AUTH_RECHECK_MS=60000
MAX_SUBMISSION_ANSWERS=500
MAX_ANSWER_TEXT_LENGTH=1000
# Optional authenticated/signed Drive webhook. Leave URL empty to disable sync.
GDRIVE_WEBHOOK_URL=
GDRIVE_WEBHOOK_BEARER_TOKEN=
GDRIVE_WEBHOOK_SIGNING_SECRET=
HF_REPORTS_REPO=
HF_REPORTS_TOKEN=
HF_REPORTS_REVISION=main
HF_REPORTS_PREFIX=reports
# Optional private GitHub disaster-recovery repository. Keep the token outside Git and scope it to this repo only.
GITHUB_BACKUP_REPO=toxichassan22/data-sync
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_PATH=scout-data
GITHUB_BACKUP_ENCRYPTION_KEY=
GITHUB_BACKUP_INTERVAL_MS=300000
# Coalesces event-driven backups (e.g. a finalised score) into a single sync.
GITHUB_BACKUP_DEBOUNCE_MS=30000
# OpenAI-compatible AI chat provider base URL. The gateway appends /chat/completions.
AI_CHAT_URL=https://opencode.ai/zen/v1
AI_CHAT_TOKEN=
# Optional comma-separated pool of provider keys. Keep this in a secret, never in git.
# If set, the gateway uses the pool; otherwise it falls back to AI_CHAT_TOKEN.
AI_CHAT_TOKEN_POOL=
AI_CHAT_MODEL=mimo-v2.5-free
# AI protection: pool concurrency and timeout. There is no per-team chat quota or local RPM limit.
AI_POOL_CONCURRENCY=
AI_PROVIDER_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=350
AI_RESPONSE_CACHE_TTL_MS=60000

# AWS EC2 & AI GPU Studio Settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AI_GPU_SERVER_URL=http://52.21.126.195:8000
EC2_GPU_INSTANCE_ID=i-00b3cf16ddd411b8f
# How long the festival agenda/competition context is cached for the assistant.
AI_CONTEXT_TTL_MS=60000
# One-time production import of the supplied official schedule; unset/false afterwards.
SYNC_OFFICIAL_AGENDA=false
