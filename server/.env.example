# Scout Festival backend environment variables
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
# SQLite path used by operational checks/backup scripts. Set an absolute production path.
SQLITE_DATABASE_PATH=./prisma/dev.db
# Persistent, access-restricted backup directory; do not place backups in public/uploads.
SQLITE_BACKUP_DIR=../scout-backups
FRONTEND_URL=https://your-huggingface-space.hf.space
# Comma-separated production allowlist; localhost is allowed automatically outside production.
CORS_ORIGINS=https://your-huggingface-space.hf.space
# Production must be a unique random value, at least 32 characters.
NODE_ENV=production
MAX_UPLOAD_BYTES=52428800
