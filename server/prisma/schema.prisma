generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Team {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  label        String
  maxDevices   Int      @default(24)
  createdAt    DateTime @default(now())

  scores            Score[]
  reports           Report[]
  reportPermissions ReportPermission[]
  judgeScores       JudgeScore[]
  scoreAudits       ScoreAudit[]
  members           TeamMember[]
  devices           TeamDevice[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  role      String   @default("عضو")
  createdAt DateTime @default(now())
}

model TeamDevice {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deviceId    String // Unique browser/device fingerprint from localStorage
  userAgent   String   @default("")
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([teamId, deviceId])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Judge {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  scores      Score[]
  assignments JudgeCompetition[]
  judgeScores JudgeScore[]
  scoreAudits ScoreAudit[]
}

model Competition {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // two_truths | genius | geography | video | custom
  type        String // auto_digital | manual_judged
  description String   @default("")
  isOpen      Boolean  @default(false)
  passcode    String? // judge passcode
  entryCode   String? // team entry code
  duration    Int? // seconds for timed auto competitions
  criteria    String   @default("[]") // JSON [{ key, label, maxScore }]
  createdAt   DateTime @default(now())

  scores            Score[]
  questions         Question[]
  reports           Report[]
  reportPermissions ReportPermission[]
  judgeAssignments  JudgeCompetition[]
  judgeScores       JudgeScore[]
  scoreAudits       ScoreAudit[]
}

model Question {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  text          String
  options       String // JSON array (strings or {text, isLie})
  correctOption Int
  points        Float       @default(10)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
}

model GeographyCountry {
  id         String @id @default(uuid())
  name       String
  capital    String
  currency   String
  division   String @default("")
  governance String @default("")
  flag       String
  mapUrl     String @default("")
  sortOrder  Int    @default(0)
}

model Score {
  id                String       @id @default(uuid())
  competitionId     String
  competition       Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judgeId           String?
  judge             Judge?       @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  values            String       @default("{}") // JSON
  total             Float
  submittedAt       DateTime     @default(now())
  isFinal           Boolean      @default(true)
  unlockedAt        DateTime?
  unlockedByAdminId String?
  unlockReason      String?
  editedByAdminId   String?
  editedAt          DateTime?
  judgeScores       JudgeScore[]
  audits            ScoreAudit[]

  @@unique([competitionId, teamId])
}

model JudgeCompetition {
  id            String      @id @default(uuid())
  judgeId       String
  judge         Judge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([judgeId, competitionId])
}

model JudgeScore {
  id            String      @id @default(uuid())
  scoreId       String
  score         Score       @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  judgeId       String
  judge         Judge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  values        String      @default("{}")
  total         Float
  submittedAt   DateTime    @default(now())

  @@unique([judgeId, competitionId, teamId])
}

model ScoreAudit {
  id            String      @id @default(uuid())
  scoreId       String
  score         Score       @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judgeId       String?
  judge         Judge?      @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  adminId       String?
  action        String
  reason        String?
  previousData  String?
  newData       String?
  createdAt     DateTime    @default(now())
}

model News {
  id               String   @id @default(uuid())
  title            String
  body             String
  photoUrl         String?
  category         String   @default("general")
  targetTeamIds    String   @default("[]") // JSON; empty means public
  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model Zone {
  id          String @id @default(uuid())
  numberLabel String
  name        String
  description String
  colorHex    String
  order       Int    @default(0)

  agendaItems AgendaItem[]
}

model AgendaItem {
  id          String    @id @default(uuid())
  title       String
  type        String // competition | workshop | ceremony
  period      String    @default("before")
  order       Int       @default(0)
  zoneId      String
  zone        Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  startTime   String
  endTime     String
  description String
  isVisible   Boolean   @default(true)
  isStarted   Boolean   @default(false)
  startedAt   DateTime?
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
}

model Report {
  id            String       @id @default(uuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  title         String       @default("")
  content       String       @default("")
  fileUrl       String
  fileName      String
  uploadedAt    DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@unique([teamId, competitionId])
}

model ReportPermission {
  id               String      @id @default(uuid())
  teamId           String
  team             Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  canSubmit        Boolean     @default(true)
  deadline         DateTime?
  reopenedAt       DateTime?
  grantedAt        DateTime    @default(now())
  revokedAt        DateTime?
  updatedByAdminId String?
  updatedAt        DateTime    @default(now()) @updatedAt

  @@unique([teamId, competitionId])
}

model QuizSession {
  id            String    @id @default(uuid())
  teamId        String
  competitionId String
  deviceId      String // Unique device fingerprint that started the quiz
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?

  draftAnswers DraftAnswer[]

  @@unique([teamId, competitionId])
}

model DraftAnswer {
  id            String      @id @default(uuid())
  sessionId     String
  session       QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  selectedIndex Int
  isCorrect     Boolean     @default(false)
  pointsEarned  Float       @default(0)
  savedAt       DateTime    @default(now())

  @@unique([sessionId, questionId])
}

model SystemSetting {
  key   String @id
  value String
}
