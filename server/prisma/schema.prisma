generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  label        String
  maxDevices   Int      @default(24)
  authVersion  Int      @default(0)
  createdAt    DateTime @default(now())

  scores                Score[]
  reports               Report[]
  reportPermissions     ReportPermission[]
  judgeScores           JudgeScore[]
  scoreAudits           ScoreAudit[]
  members               TeamMember[]
  devices               TeamDevice[]
  competitionAccess     CompetitionAccess[]
  videoAttempts         VideoAttempt[]
  standing              TeamStanding?
  activityParticipants  ActivityParticipant[]
  wallet                TeamWallet?
  walletTransactions    WalletTransaction[]
  purchases             Purchase[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name      String
  role      String   @default("عضو")
  createdAt DateTime @default(now())
}

model TeamDevice {
  id           String    @id @default(uuid())
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deviceId     String // Unique browser/device identifier from localStorage
  displayName  String    @default("") // The person's own name, required on first use
  role         String    @default("") // كشاف | مرشدة | جوال | جوالة | قائد/ة
  userAgent    String    @default("")
  tokenVersion Int       @default(0)
  revokedAt    DateTime?
  lastLoginAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@unique([teamId, deviceId])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  authVersion  Int      @default(0)
  createdAt    DateTime @default(now())
}

model Judge {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  authVersion  Int      @default(0)
  createdAt    DateTime @default(now())

  scores      Score[]
  assignments JudgeCompetition[]
  judgeScores JudgeScore[]
  scoreAudits ScoreAudit[]
}

model Competition {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique // two_truths | genius | geography | video | custom
  type               String // auto_digital | manual_judged
  description        String   @default("")
  details            String   @default("")
  isOpen             Boolean  @default(false)
  startsAt           DateTime?
  endsAt             DateTime?
  passcode           String? // judge passcode
  entryCode          String? // legacy team entry code
  qrCode             String?  @unique
  requiresQr         Boolean  @default(false)
  duration           Int? // seconds for timed auto competitions
  questionCount      Int      @default(50)
  leaderboardVisible  Boolean  @default(false)
  criteria           String   @default("[]") // JSON [{ key, label, maxScore }]
  createdAt          DateTime @default(now())

  scores            Score[]
  questions         Question[]
  reports           Report[]
  reportPermissions ReportPermission[]
  judgeAssignments  JudgeCompetition[]
  judgeScores       JudgeScore[]
  scoreAudits       ScoreAudit[]
  teamAccess        CompetitionAccess[]
  videoAttempts     VideoAttempt[]
}

model CompetitionAccess {
  id            String      @id @default(uuid())
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  grantedAt     DateTime    @default(now())
  expiresAt     DateTime?

  @@unique([teamId, competitionId])
}

model Question {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  text          String
  category      String      @default("")
  options       String // JSON array (strings or {text, isLie})
  correctOption Int
  points        Float       @default(1)
  questionType  String      @default("text")
  mediaUrl      String?
  mediaAlt      String      @default("")
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([competitionId])
}

model VideoAttempt {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  attemptNumber Int
  prompt        String
  videoUrl      String?
  videoStatus   String      @default("pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, teamId, attemptNumber])
  @@index([competitionId, teamId])
}

model GeographyCountry {
  id         String @id @default(uuid())
  name       String
  capital    String
  currency   String
  division   String @default("")
  governance String @default("")
  flag       String
  mapUrl     String @default("")
  sortOrder  Int    @default(0)
}

model Score {
  id                String       @id @default(uuid())
  competitionId     String
  competition       Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId            String
  team              Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judgeId           String?
  judge             Judge?       @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  values            String       @default("{}") // JSON
  total             Float
  attemptedCount    Int          @default(0)
  correctCount      Int          @default(0)
  questionCount     Int          @default(0)
  completedAll      Boolean      @default(false)
  submittedAt       DateTime     @default(now())
  isFinal           Boolean      @default(true)
  unlockedAt        DateTime?
  unlockedByAdminId String?
  unlockReason      String?
  editedByAdminId   String?
  editedAt          DateTime?
  judgeScores       JudgeScore[]
  audits            ScoreAudit[]

  @@unique([competitionId, teamId])
  @@index([teamId])
  @@index([teamId, submittedAt])
}

model JudgeCompetition {
  id            String      @id @default(uuid())
  judgeId       String
  judge         Judge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([judgeId, competitionId])
}

model JudgeScore {
  id            String      @id @default(uuid())
  scoreId       String
  score         Score       @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  judgeId       String
  judge         Judge       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  values        String      @default("{}")
  total         Float
  submittedAt   DateTime    @default(now())

  @@unique([judgeId, competitionId, teamId])
  @@index([teamId])
}

model ScoreAudit {
  id            String      @id @default(uuid())
  scoreId       String
  score         Score       @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judgeId       String?
  judge         Judge?      @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  adminId       String?
  action        String
  reason        String?
  previousData  String?
  newData       String?
  createdAt     DateTime    @default(now())

  @@index([teamId])
}

model News {
  id               String   @id @default(uuid())
  title            String
  body             String
  photoUrl         String?
  category         String   @default("general")
  targetTeamIds    String   @default("[]") // JSON; empty means public
  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model Zone {
  id          String @id @default(uuid())
  numberLabel String
  name        String
  description String
  colorHex    String
  order       Int    @default(0)

  agendaItems AgendaItem[]
}

model AgendaItem {
  id          String    @id @default(uuid())
  title       String
  type        String // competition | workshop | ceremony
  period      String    @default("before")
  order       Int       @default(0)
  zoneId      String
  zone        Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  // Stable source link for competition events. Kept scalar for the baseline SQLite
  // database; the app validates the target Competition and synchronizes both records.
  competitionId String?
  locationNote String    @default("")
  startTime   String
  endTime     String
  description String
  isVisible   Boolean   @default(true)
  isStarted   Boolean   @default(false)
  startedAt   DateTime?
  isClosed    Boolean   @default(false)
  closedAt    DateTime?

  @@index([competitionId])
}

model Report {
  id            String       @id @default(uuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  title         String       @default("")
  content       String       @default("")
  fileUrl       String
  fileName      String
  uploadedAt    DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@unique([teamId, competitionId])
}

model ReportPermission {
  id               String      @id @default(uuid())
  teamId           String
  team             Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competitionId    String
  competition      Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  canSubmit        Boolean     @default(true)
  deadline         DateTime?
  reopenedAt       DateTime?
  grantedAt        DateTime    @default(now())
  revokedAt        DateTime?
  updatedByAdminId String?
  updatedAt        DateTime    @default(now()) @updatedAt

  @@unique([teamId, competitionId])
}

model QuizSession {
  id             String       @id @default(uuid())
  teamId         String
  competitionId  String
  deviceId       String // Unique device identifier that started the quiz
  questionOrder  String       @default("[]")
  startedAt      DateTime     @default(now())
  expiresAt      DateTime
  lastAnswerAt   DateTime?
  attemptedCount Int          @default(0)
  correctCount   Int          @default(0)
  isCompleted    Boolean      @default(false)
  completedAt    DateTime?

  draftAnswers DraftAnswer[]

  @@unique([teamId, competitionId])
}

model DraftAnswer {
  id            String      @id @default(uuid())
  sessionId     String
  session       QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  selectedIndex Int
  isCorrect     Boolean     @default(false)
  pointsEarned  Float       @default(0)
  savedAt       DateTime    @default(now())

  @@unique([sessionId, questionId])
}

model SystemSetting {
  key   String @id
  value String
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  scope     String
  actorId   String
  key       String
  status    Int?     // null means in-progress; 200..299 stores a replayable response
  response  String?  // JSON of the first response
  createdAt DateTime @default(now())

  @@unique([scope, actorId, key])
  @@index([createdAt])
}

model TeamStanding {
  teamId          String    @id
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  totalScore      Float     @default(0)
  latestSubmitted DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([totalScore, latestSubmitted])
}

model PendingUpload {
  id           String    @id @default(uuid())
  fileName     String
  filePath     String
  mimeType     String
  folderPath   String
  status       String    @default("pending")
  retryCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  leasedUntil  DateTime?
  nextAttemptAt DateTime @default(now())

  @@index([status, leasedUntil])
  @@index([status, nextAttemptAt])
}

model Activity {
  id                 String               @id @default(uuid())
  slug               String               @unique
  name               String
  description        String               @default("")
  isOpen             Boolean              @default(true)
  config             String               @default("{}")
  createdAt          DateTime             @default(now())
  sessions           ActivitySession[]
  walletTransactions WalletTransaction[]
}

model ActivitySession {
  id                 String               @id @default(uuid())
  activityId         String
  activity           Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  roomCode           String?              @unique
  status             String               @default("waiting")
  minPlayers         Int                  @default(1)
  maxPlayers         Int                  @default(10)
  gameState          String               @default("{}")
  startedAt          DateTime?
  endedAt            DateTime?
  rewardsApplied     Boolean              @default(false)
  createdAt          DateTime             @default(now())
  participants       ActivityParticipant[]
  walletTransactions WalletTransaction[]

  @@index([activityId, status])
}

model ActivityParticipant {
  id          String          @id @default(uuid())
  sessionId   String
  session     ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deviceId    String
  displayName String
  score        Float           @default(0)
  rank         Int?
  metadata     String          @default("{}")
  eliminated   Boolean         @default(false)
  eliminatedAt DateTime?
  lastSeenAt   DateTime        @default(now())
  joinedAt     DateTime        @default(now())
  finishedAt   DateTime?

  @@unique([sessionId, deviceId])
  @@index([sessionId, teamId])
}

model TeamWallet {
  teamId       String              @id
  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  balance      Int                 @default(0)
  totalEarned  Int                 @default(0)
  totalSpent   Int                 @default(0)
  updatedAt    DateTime            @default(now()) @updatedAt
}

model WalletTransaction {
  id         String           @id @default(uuid())
  teamId     String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  activityId String?
  activity   Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  sessionId  String?
  session    ActivitySession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  type       String
  amount     Int
  reason     String
  metadata   String            @default("{}")
  createdAt  DateTime          @default(now())

  @@index([teamId, createdAt])
}

model ShopItem {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String      @default("")
  category    String      @default("cosmetic")
  price       Int
  effect      String      @default("{}")
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  purchases   Purchase[]
}

model Purchase {
  id             String   @id @default(uuid())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  itemId         String
  item           ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity       Int      @default(1)
  unitPrice      Int
  effectSnapshot String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([teamId, createdAt])
}
