{
  "name": "digital-scout-camp-server",
  "version": "1.0.0",
  "description": "Backend API & Real-time Server for Digital Scout Camp (Render + Supabase)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "build": "prisma generate",
    "dev": "node --watch src/index.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:ready": "node scripts/sqlite-readiness.mjs",
    "db:backup": "node scripts/sqlite-backup.mjs",
    "db:drift": "node scripts/prisma-drift-check.mjs",
    "test:integration": "node scripts/run-isolated-tests.mjs",
    "test:health": "node scripts/health-check.mjs",
    "test:operational": "npm run db:ready && npm run db:drift",
    "test": "npm run prisma:validate && npm run prisma:generate && npm run test:integration",
    "seed": "node src/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "socket.io": "^4.7.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
